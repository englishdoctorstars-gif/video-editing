<resources>
    <style name="Theme.Vocabsolution" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Vocabsolution.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Vocabsolution</item>
    </style>
</resources>
